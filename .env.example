# GitHub Secrets Configuration Example
# Copy these values to GitHub Secrets in your repository or organization

# ============================================================================
# AZURE CREDENTIALS (REQUIRED)
# ============================================================================
# Obtenidos del Service Principal creado con Federated Identity
# Ver SETUP.md paso 1.1 para instrucciones de creación

AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# ============================================================================
# SONARQUBE CONFIGURATION (REQUIRED)
# ============================================================================
# Token generado en SonarQube → My Account → Security → Generate Token
# Host URL es la dirección donde está corriendo SonarQube

SONARQUBE_TOKEN=squ_1234567890abcdefghijklmnopqrstuvwxyz
SONARQUBE_HOST_URL=http://sonarqube.example.com:9000

# Para desarrollo local con SonarQube en Docker:
# SONARQUBE_HOST_URL=http://localhost:9000

# Para SonarCloud (alternativa cloud):
# SONARQUBE_HOST_URL=https://sonarcloud.io
# SONARQUBE_TOKEN=<token de SonarCloud>

# ============================================================================
# SLACK NOTIFICATIONS (OPTIONAL)
# ============================================================================
# Webhook URL para notificaciones en Slack
# Ver SETUP.md paso 4.1 para crear webhook

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Si no deseas notificaciones Slack, puedes omitir este secret
# El pipeline lo detectará automáticamente y saltará las notificaciones

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================

# 1. NUNCA commitear este archivo con valores reales
# 2. Los secrets deben configurarse en:
#    - GitHub Organization Secrets (recomendado para todos los repos)
#    - O GitHub Repository Secrets (individual por repo)
#
# 3. Para configurar via GitHub CLI:
#    gh secret set SECRET_NAME -b"secret_value" --org IngesoftV-backend-microservices
#    # o
#    gh secret set SECRET_NAME -b"secret_value" --repo owner/repo
#
# 4. Para configurar via GitHub UI:
#    Organization: Settings → Secrets and variables → Actions → New organization secret
#    Repository: Settings → Secrets and variables → Actions → New repository secret

# ============================================================================
# VALIDACIÓN DE SECRETS
# ============================================================================

# Verificar que todos los secrets están configurados:
# gh secret list --org IngesoftV-backend-microservices
# o
# gh secret list --repo IngesoftV-backend-microservices/user-service

# Debería mostrar:
# AZURE_CLIENT_ID
# AZURE_TENANT_ID
# AZURE_SUBSCRIPTION_ID
# SONARQUBE_TOKEN
# SONARQUBE_HOST_URL
# SLACK_WEBHOOK_URL

# ============================================================================
# TROUBLESHOOTING
# ============================================================================

# Si el pipeline falla con "Secret not found":
# 1. Verificar que el secret existe: gh secret list
# 2. Verificar el nombre exacto (case-sensitive)
# 3. Verificar permisos del workflow (debe tener access a secrets)
# 4. Para Organization secrets, verificar que el repo tiene acceso

# Si el pipeline falla con "Azure login failed":
# 1. Verificar que los valores son correctos
# 2. Verificar que el Service Principal tiene permisos
# 3. Verificar que Federated Credential está configurado correctamente
#    az ad app federated-credential list --id $APP_ID

# Si el pipeline falla con "SonarQube authentication failed":
# 1. Verificar que el token es válido:
#    curl -u ${SONARQUBE_TOKEN}: ${SONARQUBE_HOST_URL}/api/authentication/validate
# 2. Verificar que el proyecto existe en SonarQube
# 3. Verificar que SONARQUBE_HOST_URL es accesible desde GitHub Actions
#    (debe ser URL pública o usar GitHub-hosted runner con VPN)
